{
  "info": {
    "name": "Interview Atlas API",
    "description": "Requests for the Interview Atlas backend document workflow.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000"
    },
    {
      "key": "uploadId",
      "value": ""
    },
    {
      "key": "documentPath",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      }
    },
    {
      "name": "Upload document",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {",
              "    const response = pm.response.json();",
              "    pm.environment.set('uploadId', response.uploadId);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "document",
              "type": "file",
              "src": "{{documentPath}}"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/documents/upload",
          "host": ["{{baseUrl}}"],
          "path": ["documents", "upload"]
        }
      }
    },
    {
      "name": "Get document status",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/documents/{{uploadId}}",
          "host": ["{{baseUrl}}"],
          "path": ["documents", "{{uploadId}}"]
        }
      }
    },
    {
      "name": "Query hybrid retrieval",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"question\": \"What are TypeScript interfaces?\",\n  \"topK\": 5\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/query",
          "host": ["{{baseUrl}}"],
          "path": ["query"]
        }
      }
    }
  ]
}
